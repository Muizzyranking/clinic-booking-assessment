# Required: callers must send this in the X-API-Key header.
# It is also the password for the dashboard.
API_KEY=change-me

# Where the SQLite file lives. On a host, point this at the mounted volume.
LOG_LEVEL=INFO

# Fill an empty database with random doctors, slots and bookings on startup.
SEED_ON_STARTUP=true
# SEED_RANDOM_SEED=42        # uncomment for the same demo data every time

# Browser origins allowed to call the API (comma separated), or *
CORS_ORIGINS=*
